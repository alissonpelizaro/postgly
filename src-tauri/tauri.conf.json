{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postgly",
  "version": "0.1.0",
  "identifier": "com.alissonpelizaro.postgly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postgly",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Alisson Pelizaro. MIT licensed.",
    "shortDescription": "Modern multi-database management app",
    "longDescription": "Postgly is a desktop client for browsing, querying and managing Postgres databases, with an optional AI assistant powered by any OpenAI-compatible endpoint.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
